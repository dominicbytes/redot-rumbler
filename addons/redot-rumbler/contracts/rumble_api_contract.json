{
  "schema_version": 1,
  "platform": "rumble",
  "platform_api_version": "1.1",
  "source_url": "https://rumble.support/help/how-to-use-rumble-s-live-stream-api",
  "source_last_updated": "2025-11-20",
  "source_checked": "2026-08-11",
  "normalized_fields_sha256": "4c93df62fb2030cecd2369d72ea5992a85868d0ab9aa2e9b77ea642c4e2e03b4",
  "transport": {
    "method": "GET",
    "read_only": true,
    "credential": "entire_api_url",
    "default_poll_interval_seconds": 5,
    "minimum_poll_interval_seconds": 2,
    "recent_chat_and_rant_limit": 50,
    "livestream_fields_only_while_live": true
  },
  "secret_fields": [
    "request.url",
    "livestreams[].stream_key"
  ],
  "fields": [
    "now",
    "type",
    "user_id",
    "channel_id",
    "since",
    "max_num_results",
    "followers.num_followers",
    "followers.num_followers_total",
    "followers.latest_follower.username",
    "followers.latest_follower.followed_on",
    "followers.recent_followers[]",
    "subscribers.num_subscribers",
    "subscribers.latest_subscriber.user",
    "subscribers.latest_subscriber.username",
    "subscribers.latest_subscriber.amount_cents",
    "subscribers.latest_subscriber.amount_dollars",
    "subscribers.latest_subscriber.subscribed_on",
    "subscribers.recent_subscribers[]",
    "gifted_subs.num_gifted_subs",
    "gifted_subs.latest_gifted_sub.total_gifts",
    "gifted_subs.latest_gifted_sub.gift_type",
    "gifted_subs.latest_gifted_sub.remaining_gifts",
    "gifted_subs.latest_gifted_sub.video_id",
    "gifted_subs.latest_gifted_sub.purchased_by",
    "gifted_subs.recent_gifted_subs[]",
    "livestreams[].id",
    "livestreams[].title",
    "livestreams[].created_on",
    "livestreams[].is_live",
    "livestreams[].categories.primary.slug",
    "livestreams[].categories.primary.title",
    "livestreams[].categories.secondary.slug",
    "livestreams[].categories.secondary.title",
    "livestreams[].likes",
    "livestreams[].dislikes",
    "livestreams[].watching_now",
    "livestreams[].chat.latest_message",
    "livestreams[].chat.recent_messages[]",
    "livestreams[].chat.latest_rant",
    "livestreams[].chat.recent_rants[]"
  ],
  "supported_capabilities": [
    "identity.read",
    "followers.read",
    "subscriptions.read",
    "gifted_subscriptions.read",
    "livestreams.read",
    "chat.read",
    "rants.read",
    "commands.local",
    "credentials.persist"
  ],
  "unavailable_capabilities": [
    "chat.write",
    "moderation",
    "rewards.manage",
    "raids",
    "media.download"
  ],
  "unknown_field_policy": "record bounded field paths only; never retain unknown values"
}
